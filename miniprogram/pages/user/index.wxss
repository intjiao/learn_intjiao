/* miniprogram/pages/user/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  padding: 48rpx 32rpx;
  color: #fff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 28rpx;
}

.user-info .name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-info .phone {
  font-size: 26rpx;
  opacity: 0.8;
}

.menu-section {
  background: #fff;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  color: #666;
  font-size: 24rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-btn {
  margin: 40rpx 32rpx;
  height: 88rpx;
  background: #fff;
  color: #F44336;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
