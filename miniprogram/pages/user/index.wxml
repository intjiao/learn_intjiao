<!-- miniprogram/pages/user/index.wxml -->
<view class="page">
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatar || '/assets/images/avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="name">{{userInfo.realname || '学员'}}</text>
      <text class="phone">{{userInfo.phone || '未绑定手机'}}</text>
    </view>
  </view>

  <view class="menu-section" wx:for="{{menuItems}}" wx:key="index">
    <view class="menu-item" wx:for="{{item}}" wx:for-item="menuItem" wx:key="id" bindtap="onItemTap" data-id="{{menuItem.id}}">
      <view class="menu-left">
        <view class="menu-icon">
          <text>{{menuItem.icon}}</text>
        </view>
        <text class="menu-title">{{menuItem.title}}</text>
      </view>
      <text class="menu-arrow" wx:if="{{menuItem.arrow}}">&#xe60c;</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
