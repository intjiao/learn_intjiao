/* miniprogram/pages/course/detail.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 140rpx;
}

.course-header {
  background: #fff;
}

.cover {
  width: 100%;
  height: 400rpx;
}

.header-info {
  padding: 32rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}

.meta {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: #999;
}

.progress-section {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.progress-text {
  color: #1890FF;
  font-weight: 600;
}

.progress-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890FF, #0050B3);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.section {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.chapter-list {
  margin-top: -8rpx;
}

.chapter-item {
  margin-bottom: 24rpx;
}

.chapter-header {
  padding: 20rpx 0;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.resource-list {
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.resource-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.resource-item:last-child {
  border-bottom: none;
}

.resource-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  color: #fff;
  font-size: 28rpx;
}

.resource-info {
  flex: 1;
}

.resource-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.resource-duration {
  font-size: 24rpx;
  color: #999;
}

.resource-status {
  font-size: 24rpx;
}

.completed {
  color: #43A047;
}

.not-start {
  color: #999;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.btn-enroll {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
