/* miniprogram/pages/course/video.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx;
}

.hero-card,
.preview-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #1890FF;
  font-size: 24rpx;
}

.desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.player {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

.audio-player {
  min-height: 120rpx;
}

.image-preview {
  width: 100%;
  border-radius: 16rpx;
}

.tip-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.file-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.file-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.file-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.copy-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}