/* miniprogram/pages/exam/answer.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.exam-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
}

.timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timer-icon {
  font-size: 32rpx;
}

.timer-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.timer-text.warning {
  color: #F44336;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.progress-info {
  font-size: 28rpx;
  color: #999;
}

.submit-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.question-area {
  flex: 1;
  padding: 32rpx;
}

.question-type {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #E6F0FB;
  color: #1890FF;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.question-stem {
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 32rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.option-item:active {
  background: #f8f9fa;
}

.option-item.selected {
  border-color: #1890FF;
  background: #E6F0FB;
}

.option-label {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #1890FF;
  color: #fff;
}

.option-content {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.exam-footer {
  background: #fff;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.nav-btns {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.nav-btn {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn:active:not(.disabled) {
  background: #eee;
}

.nav-btn.disabled {
  opacity: 0.4;
}

.question-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ddd;
}

.dot.active {
  background: #1890FF;
}

.dot.answered {
  background: #43A047;
}

.dot.active.answered {
  background: #1890FF;
}
