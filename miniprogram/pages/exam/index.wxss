/* miniprogram/pages/exam/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #1890FF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #1890FF;
  border-radius: 2rpx;
}

.exam-list {
  padding: 24rpx;
}

.exam-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.exam-info {
  margin-bottom: 20rpx;
}

.exam-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.exam-meta {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.exam-time {
  font-size: 24rpx;
  color: #ccc;
}

.exam-action {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.result-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.result-badge.pass {
  background: #E8F5E9;
  color: #43A047;
}

.result-badge.fail {
  background: #FFEBEE;
  color: #F44336;
}

.btn-start, .btn-view {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn-start {
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  color: #fff;
}

.btn-view {
  background: #f5f5f5;
  color: #666;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
