/* miniprogram/pages/exam/result.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fa;
}

.result-header {
  text-align: center;
  padding: 80rpx 0;
}

.result-header.pass {
  background: linear-gradient(135deg, #43A047 0%, #2E7D32 100%);
}

.result-header.fail {
  background: linear-gradient(135deg, #FF7043 0%, #E64A19 100%);
}

.result-icon {
  font-size: 120rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.result-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin: -40rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
}

.score-section {
  text-align: center;
  margin-bottom: 48rpx;
}

.score-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.score {
  font-size: 100rpx;
  font-weight: 800;
  color: #333;
}

.score-total {
  font-size: 40rpx;
  color: #999;
  margin-left: 8rpx;
}

.score-label {
  font-size: 28rpx;
  color: #999;
  margin-top: 8rpx;
}

.score-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-value.correct {
  color: #43A047;
}

.stat-value.wrong {
  color: #F44336;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.paper-info {
  text-align: center;
  padding: 24rpx;
}

.paper-title {
  font-size: 28rpx;
  color: #666;
}

.action-buttons {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-view-answers {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-back {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
