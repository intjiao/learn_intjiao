<!-- miniprogram/pages/exam/result.wxml -->
<view class="page" wx:if="{{record}}">
  <view class="result-header {{record.pass_status == 1 ? 'pass' : 'fail'}}">
    <view class="result-icon">
      <text wx:if="{{record.pass_status == 1}}">&#xe60a;</text>
      <text wx:else>&#xe60b;</text>
    </view>
    <text class="result-text">{{record.pass_status == 1 ? '恭喜通过！' : '继续加油！'}}</text>
  </view>

  <view class="result-card">
    <view class="score-section">
      <view class="score-main">
        <text class="score">{{record.score || 0}}</text>
        <text class="score-total">/{{record.total_score || 100}}</text>
      </view>
      <view class="score-label">得分</view>
    </view>
    <view class="score-stats">
      <view class="stat-item">
        <text class="stat-value correct">{{record.correct_count || 0}}</text>
        <text class="stat-label">正确</text>
      </view>
      <view class="stat-item">
        <text class="stat-value wrong">{{record.wrong_count || 0}}</text>
        <text class="stat-label">错误</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{record.duration ? Math.floor(record.duration / 60) + '分' + (record.duration % 60) + '秒' : '0分'}}</text>
        <text class="stat-label">用时</text>
      </view>
    </view>
  </view>

  <view class="paper-info">
    <text class="paper-title">{{record.paper_title || '考试'}}</text>
  </view>

  <view class="action-buttons">
    <view class="btn-view-answers" bindtap="viewAnswers">查看答卷</view>
    <view class="btn-back" bindtap="goBack">返回</view>
  </view>
</view>
