/* miniprogram/app.wxss */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1890FF 0%, #0050B3 100%);
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #1890FF;
  border: 2rpx solid #1890FF;
}

.btn-disabled {
  background: #ddd;
  color: #999;
}

.input-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.input-item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-item:last-child {
  border-bottom: none;
}

.input-label {
  width: 160rpx;
  color: #666;
  font-size: 30rpx;
}

.input-field {
  flex: 1;
  height: 100rpx;
  font-size: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 32rpx 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:active {
  background: #f8f9fa;
}

.list-item:last-child {
  border-bottom: none;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.badge-primary {
  background: #E6F0FB;
  color: #1890FF;
}

.badge-success {
  background: #E8F5E9;
  color: #43A047;
}

.badge-warning {
  background: #FFF8E1;
  color: #FF9800;
}

.badge-danger {
  background: #FFEBEE;
  color: #F44336;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-state text {
  display: block;
  font-size: 28rpx;
}
